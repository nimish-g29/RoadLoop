# Copy to .env and fill in.

# "live" calls the real TinyFish API; "mock" calls the mock service on :8100.
TINYFISH_MODE=mock
TINYFISH_API_KEY=

# Public base URL of this API, used for TinyFish webhooks and photo links.
# TinyFish must be able to reach it: use an ngrok / cloudflared tunnel during the hackathon.
PUBLIC_BASE_URL=http://localhost:8000

# Secret path segment that protects webhook endpoints (TinyFish webhooks are unsigned).
WEBHOOK_TOKEN=change-me-to-a-long-random-string

# Days a filed complaint may stay open before RoadLoop escalates it.
SLA_DAYS=7

# Monitor schedule for public complaint-status pages (cron, IST).
MONITOR_CRON=CRON_TZ=Asia/Kolkata 0 */6 * * *

# Reverse geocoding of new hotspots via OpenStreetMap Nominatim ("off" to disable).
GEOCODER=nominatim

# Optional: protects /v1/admin/* and authority corrections. The dashboard sends it automatically.
ADMIN_TOKEN=

# Area memory: reuse a learned authority for new potholes in the same ~1 km area (geohash 6).
AREA_PRECISION=6

# Hands-free capture on the phone: minimum jolt (g), how far above the road's normal shaking a
# pothole must be, and the minimum speed (km/h) below which bumps are ignored.
BUMP_MIN_G=0.4
BUMP_NOISE_K=3.5
BUMP_MIN_SPEED_KMH=8

# Celery worker processes per container (scale containers with --scale worker=N).
WORKER_CONCURRENCY=4
